	(gr_text "PCB00 ARCHITECTURE: F.Cu=components/signal/local power; In1.Cu=continuous GND reference; In2.Cu=power/signal; B.Cu=signal. L2_SOLID_GND_PLANE_REALIZED=NO."
		(at 75 135 0)
		(layer "Cmts.User")
		(uuid "6b4e5a79-1a7a-44da-be2e-12e0fc96d991")
		(effects
