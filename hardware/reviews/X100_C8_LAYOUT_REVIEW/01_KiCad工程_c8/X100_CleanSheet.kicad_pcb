		)
	)
	(gr_text "PCB00 ARCHITECTURE: F.Cu=components/signal/local power; In1.Cu=continuous GND reference; In2.Cu=power/signal; B.Cu=signal. L2_SOLID_GND_PLANE_REALIZED=NO."
		(at 75 135 0)
		(layer "Cmts.User")
		(uuid "6b4e5a79-1a7a-44da-be2e-12e0fc96d991")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(gr_text "PCB02C RULES: JLCPCB / JLC04161H-3313 / order 1.6mm; F/B 1oz, In1/In2 0.5oz. In1 CONTINUOUS SOLID GND, NO SPLIT. Standard through via 0.60/0.30; NO VIA IN PAD, NO BLIND/BURIED/MICROVIAS. USB F.Cu/In1 reference 90ohm, W=0.1537 G=0.20. Edge.Cuts 45x45 center100,100. PCB03 ROUTING HOLD until REAL DRC blockers closed; FORMAL tracks/vias/zones=0."
		(at 75 140 0)
		(layer "Cmts.User")
		(uuid "890d28d9-44d4-49ca-94e6-40fdf942834c")
		(effects
